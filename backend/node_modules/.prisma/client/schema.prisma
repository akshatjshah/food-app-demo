generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  customer
  admin
  chef
  delivery
}

enum OrderStatus {
  pending_payment
  placed
  confirmed
  preparing
  ready
  rider_assigned
  picked_up
  out_for_delivery
  delivered
  cancelled
  rejected
}

enum PaymentMethod {
  upi
  card
  net_banking
  wallet
  cod
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum SubscriptionStatus {
  active
  paused
  completed
  cancelled
}

enum WalletTransactionType {
  credit
  debit
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  phoneNumber   String   @unique @map("phone_number") @db.VarChar(15)
  fullName      String?  @map("full_name") @db.VarChar(100)
  email         String?  @unique @db.VarChar(255)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  role          UserRole @default(customer)
  walletBalance Decimal  @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  isBlocked     Boolean  @default(false) @map("is_blocked")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  addresses          Address[]
  fcmTokens          FcmToken[]
  cart               Cart?
  orders             Order[]             @relation("CustomerOrders")
  chefOrders         Order[]             @relation("ChefOrders")
  deliveryOrders     Order[]             @relation("DeliveryOrders")
  subscriptions      UserSubscription[]
  walletTransactions WalletTransaction[]
  loyaltyPoints      LoyaltyPoint[]
  notifications      Notification[]
  auditLogs          AdminAuditLog[]
  reviews            Review[]
  wishlist           Wishlist[]
  refreshTokens      RefreshToken[]
  shortLikes         FoodShortLike[]
  CouponUsage        CouponUsage[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String   @db.VarChar(50)
  addressLine1 String   @map("address_line1") @db.Text
  addressLine2 String?  @map("address_line2") @db.Text
  city         String   @default("Ahmedabad") @db.VarChar(100)
  state        String   @default("Gujarat") @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(10)
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  phone        String   @db.VarChar(15)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model FcmToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.Text
  platform  String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("fcm_tokens")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  icon         String   @db.VarChar(10)
  imageUrl     String?  @map("image_url") @db.Text
  description  String?  @db.Text
  isFeatured   Boolean  @default(false) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  foodItems FoodItem[]
  shorts    Short[]

  @@map("categories")
}

model FoodItem {
  id                     String    @id @default(uuid()) @db.Uuid
  categoryId             String    @map("category_id") @db.Uuid
  name                   String    @db.VarChar(150)
  description            String?   @db.Text
  price                  Decimal   @db.Decimal(10, 2)
  originalPrice          Decimal?  @map("original_price") @db.Decimal(10, 2)
  imageUrls              Json      @default("[]") @map("image_urls")
  videoUrl               String?   @map("video_url") @db.Text
  calories               Int?
  preparationTimeMinutes Int       @default(20) @map("preparation_time_minutes")
  isVeg                  Boolean   @default(true) @map("is_veg")
  isJainAvailable        Boolean   @default(false) @map("is_jain_available")
  isFastingFriendly      Boolean   @default(false) @map("is_fasting_friendly")
  isActive               Boolean   @default(true) @map("is_active")
  isBestseller           Boolean   @default(false) @map("is_bestseller")
  isHealthyPick          Boolean   @default(false) @map("is_healthy_pick")
  stock                  Int?
  displayOrder           Int       @default(0) @map("display_order")
  tags                   Json      @default("[]")
  rating                 Decimal   @default(0.00) @db.Decimal(3, 2)
  reviewsCount           Int       @default(0) @map("reviews_count")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customizationGroups CustomizationGroup[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reviews             Review[]
  wishlist            Wishlist[]
  shorts              Short[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@index([isBestseller])
  @@index([deletedAt])
  @@map("food_items")
}

model CustomizationGroup {
  id            String   @id @default(uuid()) @db.Uuid
  foodItemId    String   @map("food_item_id") @db.Uuid
  name          String   @db.VarChar(100)
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int      @default(1) @map("max_selections")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  foodItem FoodItem            @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  items    CustomizationItem[]

  @@index([foodItemId])
  @@map("customization_groups")
}

model CustomizationItem {
  id              String  @id @default(uuid()) @db.Uuid
  groupId         String  @map("group_id") @db.Uuid
  name            String  @db.VarChar(100)
  additionalPrice Decimal @default(0.00) @map("additional_price") @db.Decimal(10, 2)
  isActive        Boolean @default(true) @map("is_active")
  displayOrder    Int     @default(0) @map("display_order")

  group                   CustomizationGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemCustomizations OrderItemCustomization[]

  @@index([groupId])
  @@map("customization_items")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  foodItemId          String   @map("food_item_id") @db.Uuid
  quantity            Int
  customizationItems  Json     @default("[]") @map("customization_items")
  specialInstructions String?  @map("special_instructions") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

model Banner {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(150)
  subtitle     String?  @db.VarChar(255)
  imageUrl     String   @map("image_url") @db.Text
  clickAction  String?  @map("click_action") @db.VarChar(50)
  actionValue  String?  @map("action_value") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  startDate    DateTime @map("start_date") @db.Timestamptz()
  endDate      DateTime @map("end_date") @db.Timestamptz()
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("banners")
}

model Short {
  id           String   @id @default(uuid()) @db.Uuid
  videoUrl     String   @map("video_url") @db.Text
  thumbnailUrl String   @map("thumbnail_url") @db.Text
  caption      String?  @db.Text
  foodItemId   String?  @map("food_item_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  likesCount   Int      @default(0) @map("likes_count")
  viewsCount   Int      @default(0) @map("views_count")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  foodItem FoodItem?       @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  likes    FoodShortLike[]

  @@index([foodItemId])
  @@index([categoryId])
  @@map("shorts")
}

model FoodShortLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  shortId   String   @map("short_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  short Short @relation(fields: [shortId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
  @@index([userId])
  @@index([shortId])
  @@map("food_short_likes")
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  addressId           String?       @map("address_id") @db.Uuid
  status              OrderStatus   @default(placed)
  paymentMethod       PaymentMethod @default(upi) @map("payment_method")
  paymentStatus       PaymentStatus @default(pending) @map("payment_status")
  paymentReferenceId  String?       @map("payment_reference_id") @db.VarChar(255)
  itemTotal           Decimal       @map("item_total") @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  deliveryFee         Decimal       @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  platformFee         Decimal       @default(2.00) @map("platform_fee") @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  grandTotal          Decimal       @map("grand_total") @db.Decimal(10, 2)
  specialInstructions String?       @map("special_instructions") @db.Text
  deliverySlot        String        @map("delivery_slot") @db.VarChar(100)
  otpCode             String        @map("otp_code") @db.VarChar(6)
  chefId              String?       @map("chef_id") @db.Uuid
  deliveryBoyId       String?       @map("delivery_boy_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz()

  user              User                 @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  address           Address?             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  chef              User?                @relation("ChefOrders", fields: [chefId], references: [id], onDelete: SetNull)
  deliveryBoy       User?                @relation("DeliveryOrders", fields: [deliveryBoyId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  couponUsages      CouponUsage[]
  Review            Review[]
  WalletTransaction WalletTransaction[]
  LoyaltyPoint      LoyaltyPoint[]

  @@index([userId])
  @@index([status])
  @@index([deliveryBoyId])
  @@index([chefId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  fromStatus  String?  @map("from_status") @db.VarChar(30)
  toStatus    String   @map("to_status") @db.VarChar(30)
  triggeredBy String?  @map("triggered_by") @db.Uuid
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  foodItemId String   @map("food_item_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem       FoodItem                 @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  customizations OrderItemCustomization[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemCustomization {
  id                  String  @id @default(uuid()) @db.Uuid
  orderItemId         String  @map("order_item_id") @db.Uuid
  customizationItemId String  @map("customization_item_id") @db.Uuid
  name                String  @db.VarChar(100)
  price               Decimal @db.Decimal(10, 2)

  orderItem         OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customizationItem CustomizationItem @relation(fields: [customizationItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("order_item_customizations")
}

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int      @map("duration_days")
  mealsCount   Int      @map("meals_count")
  mealType     String   @map("meal_type") @db.VarChar(50)
  benefits     Json     @default("[]")
  imageUrl     String?  @map("image_url") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userSubscriptions UserSubscription[]

  @@map("subscriptions")
}

model UserSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  subscriptionId String             @map("subscription_id") @db.Uuid
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  mealsRemaining Int                @map("meals_remaining")
  status         SubscriptionStatus @default(active)
  skipDates      Json               @default("[]") @map("skip_dates")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz()

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("user_subscriptions")
}

model Coupon {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(50)
  description      String?  @db.Text
  discountType     String   @map("discount_type") @db.VarChar(20)
  discountValue    Decimal  @map("discount_value") @db.Decimal(10, 2)
  minOrderValue    Decimal? @map("min_order_value") @db.Decimal(10, 2)
  maxDiscountValue Decimal? @map("max_discount_value") @db.Decimal(10, 2)
  maxUses          Int?     @map("max_uses")
  maxUsesPerUser   Int?     @default(1) @map("max_uses_per_user")
  currentUses      Int      @default(0) @map("current_uses")
  isFirstOrderOnly Boolean  @default(false) @map("is_first_order_only")
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  usages CouponUsage[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  orderId  String   @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at") @db.Timestamptz()

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usage")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  foodItemId String   @map("food_item_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  rating     Int
  comment    String?  @db.Text
  images     Json     @default("[]")
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([foodItemId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model Wishlist {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  foodItemId String   @map("food_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foodItemId])
  @@index([userId])
  @@index([foodItemId])
  @@map("wishlist")
}

model WalletTransaction {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  type             WalletTransactionType
  amount           Decimal               @db.Decimal(10, 2)
  description      String                @map("description") @db.VarChar(255)
  referenceOrderId String?               @map("reference_order_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz()

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceOrder Order? @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([referenceOrderId])
  @@map("wallet_transactions")
}

model LoyaltyPoint {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  points           Int
  transactionType  String   @map("transaction_type") @db.VarChar(20)
  description      String   @map("description") @db.VarChar(255)
  referenceOrderId String?  @map("reference_order_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceOrder Order? @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("loyalty_points")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  body        String   @db.Text
  type        String   @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.VarChar(255)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DeliverySlot {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  maxOrders    Int      @default(10) @map("max_orders")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("delivery_slots")
}

model AdminAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Setting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  valueType   String   @default("string") @map("value_type") @db.VarChar(20)
  description String?  @db.Text
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("settings")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
